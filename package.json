{
  "name": "kira-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "setup:local": "node scripts/configure-local.mjs",
    "setup:check": "node scripts/setup-check.mjs",
    "db:bootstrap:generate": "tsx scripts/generate-live-bootstrap.ts",
    "test:e2e:connected": "playwright test --config playwright.connected.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "ai": "7.0.105",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cn": "^0.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "latest",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "parse5": "^8.0.1",
    "radix-ui": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
    "saxes": "^6.0.0",
    "server-only": "latest",
    "tailwind-merge": "latest",
    "unpdf": "^1.8.1",
    "workflow": "^4.8.9",
    "yauzl": "^3.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "latest",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22.0.0"
