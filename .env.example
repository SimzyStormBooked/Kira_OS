# Demo works without credentials. Connected mode requires the four values below.
KIRA_WORKSPACE_MODE=demo
KIRA_AUTHOR_ID=10000000-0000-4000-8000-000000000001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Live model providers are not enabled by this release.
AI_PROVIDER=demo
AI_RAVEN_MODEL=deterministic-v1
AI_SPECIALIST_MODEL=deterministic-v1
# Never add service-role or secret Supabase keys to this web app.
