# Phase One works without credentials. The interactive app uses browser-local demo data.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future authenticated persistence; the server factory is ready, but live mode is not enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved for server-side provider adapters; never prefix provider keys with NEXT_PUBLIC_.
AI_PROVIDER=demo
AI_RAVEN_MODEL=deterministic-v1
AI_SPECIALIST_MODEL=deterministic-v1

# The creative firewall is enforced in lib/ai/policy.ts, not client-editable env flags.
# No service-role key is required by the web application.
